# Flask session signing key. Replace with a long random value in production.
SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated origins allowed to connect to the API and Socket.IO.
CORS_ORIGINS=http://localhost:5500

# Local development services.
MONGODB_URI=mongodb://localhost:27017/rani_cab
REDIS_URL=redis://localhost:6379/0

# Credentials used by the admin login endpoint.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Backend listening port.
PORT=5000

# for google account login & signup
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret   
GOOGLE_REDIRECT_URI=replace-with-your-google-redirect-uri

# mail smtp settings
sender_email=replace-with-your-email
sender_app_password=replace-with-your-email-password