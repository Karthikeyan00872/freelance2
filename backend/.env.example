# Flask session signing key. Replace with a long random value in production.
SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated origins allowed to connect to the API and Socket.IO.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5500,http://127.0.0.1:5500
SOCKETIO_ASYNC_MODE=threading

# Local development services.
MONGODB_URI=mongodb://localhost:27017/rani_cab
REDIS_URL=redis://localhost:6379/0

# Credentials used by the admin login endpoint.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# Backend listening port.
PORT=5000

# Google Identity Services client id for Continue with Google.
GOOGLE_CLIENT_ID=replace-with-your-google-client-id

# SMTP settings for OTP/reset emails. The sender display name is RaniCab.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=replace-with-your-email
SENDER_APP_PASSWORD=replace-with-your-email-password
